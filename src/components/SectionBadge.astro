---
interface Props {
	label: string;
}

const { label } = Astro.props;
---

<p class="badge"><span class="dot" aria-hidden="true"></span>{label}</p>

<style>
	.badge {
		display: inline-flex;
		align-items: center;
		gap: 0.85em;
		padding: 0.5em 0.9em 0.5em 0.8em;
		border-radius: 6px;
		background: color-mix(in srgb, var(--green) 9%, transparent);
		color: var(--green-text);
		font-family: var(--font-mono);
		font-size: clamp(10.5px, 0.8vw, 12px);
		letter-spacing: 0.14em;
		text-transform: uppercase;
	}

	/* The dot keeps the bright accent */
	.dot {
		position: relative;
		color: var(--green);
		width: 0.55em;
		height: 0.55em;
		border-radius: 50%;
		background: currentColor;
	}

	.dot::before,
	.dot::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: 50%;
		background: currentColor;
		opacity: 0;
		animation: radar 2.4s ease-out infinite;
	}

	.dot::after {
		animation-delay: 1.2s;
	}

	@keyframes radar {
		0% {
			opacity: 0.35;
			transform: scale(1);
		}

		100% {
			opacity: 0;
			transform: scale(2.6);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.dot::before,
		.dot::after {
			animation: none;
		}
	}
</style>
