---
import SectionBadge from './SectionBadge.astro';

export interface SpecGroup {
	name: string;
	// 'stack' lists one item per line, 'inline' runs them along a dotted row
	layout: 'stack' | 'inline';
	items: { name: string; detail?: string }[];
}

interface Props {
	id: string;
	// Text of the tag at the top of the section
	label: string;
	// Section heading for screen readers
	title: string;
	// What the counts are counting, e.g. "certifications"
	unit: string;
	groups: SpecGroup[];
	note?: string;
	// Heading size: 'md' suits longer group names
	size?: 'lg' | 'md';
	// Pin the section and scroll the grid inside it when it is taller than the screen
	pin?: boolean;
}

const { id, label, title, unit, groups, note, size = 'lg', pin = false } = Astro.props;
---

<section class:list={['spec', size]} id={id} data-pin-section={pin ? '' : undefined}>
	<div class="pin" data-pin>
		<header class="head">
			<SectionBadge label={label} />
			<h2 class="sr-only">{title}</h2>
			{note && <p class="note">{note}</p>}
			<span class="progress" aria-hidden="true"></span>
		</header>

		<div class="window" data-window>
			<div class="grid" data-track>
				{
					groups.map((group) => (
						<article class="group">
							<div class="top">
								<h3>{group.name}</h3>
								<p class="count" aria-label={`${group.items.length} ${unit}`}>
									{String(group.items.length).padStart(2, '0')}
								</p>
							</div>
							<ul class:list={['list', group.layout]}>
								{group.items.map((item) => (
									<li>
										<span>{item.name}</span>
										{item.detail && <span class="detail">{item.detail}</span>}
									</li>
								))}
							</ul>
						</article>
					))
				}
			</div>
		</div>
	</div>

	<script>
		import '../scripts/pin-scroll';
	</script>
</section>

<style>
	.spec {
		--gutter: clamp(14px, 1.6vw, 24px);
		padding: 0 clamp(20px, 5.4vw, 90px) clamp(64px, 9vw, 150px);
	}

	.head {
		margin-inline: calc(var(--gutter) * -1);
		padding: 0 var(--gutter) clamp(20px, 2.2vw, 32px);
		border-bottom: 1px solid var(--rule);
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	.note {
		max-width: 62em;
		margin-top: clamp(14px, 1.5vw, 22px);
		color: var(--ink-faint);
		font-family: var(--font-mono);
		font-size: clamp(10.5px, 0.8vw, 12px);
		line-height: 1.7;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.head {
		position: relative;
	}

	.progress {
		display: none;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(2, minmax(0, 1fr));
		gap: clamp(48px, 6vw, 100px) clamp(40px, 7vw, 130px);
		padding-top: clamp(36px, 4.5vw, 72px);
	}

	/* Pinned (set by the script once it has measured the grid): the section is as tall
	   as one screen plus the grid's overflow, and its contents stick to the screen
	   while that extra height scrolls past. */
	/* Two of these in a row: the second needs its own space above when it is not pinned */
	.spec + .spec {
		padding-top: clamp(64px, 9vw, 150px);
	}

	.spec[data-pinned] {
		padding-block: 0;
	}

	[data-pinned] .pin {
		position: sticky;
		top: 0;
		display: flex;
		flex-direction: column;
		height: 100svh;
		padding-block: clamp(76px, 7.5vw, 116px) clamp(20px, 2.4vw, 40px);
	}

	[data-pinned] .window {
		flex: 1;
		min-height: 0;
		overflow: hidden;
		margin-inline: calc(var(--gutter) * -1);
		padding-inline: var(--gutter);
		mask-image: linear-gradient(to bottom, transparent, #000 28px, #000 calc(100% - 48px), transparent);
	}

	[data-pinned] .grid {
		padding-block: clamp(30px, 3.4vw, 56px) 56px;
		will-change: transform;
	}

	/* The header's divider fills with green as the grid scrolls through */
	[data-pinned] .progress {
		position: absolute;
		inset: auto 0 -1px;
		display: block;
		height: 1px;
		background: var(--green);
		transform: scaleX(var(--progress, 0));
		transform-origin: left;
	}

	/* Heavy group name against a small mono count, with a hairline under both */
	.top {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 24px;
		padding-bottom: clamp(14px, 1.5vw, 22px);
		border-bottom: 1px solid var(--rule);
		transition: border-color 0.3s;
	}

	h3 {
		margin: 0;
		font-size: clamp(34px, 4vw, 64px);
		text-wrap: balance;
		font-weight: 700;
		line-height: 0.95;
		letter-spacing: -0.04em;
		transition: transform 0.4s cubic-bezier(0.22, 1, 0.36, 1);
	}

	/* Longer group names (e.g. skill categories) get a smaller heading */
	.md h3 {
		font-size: clamp(28px, 2.9vw, 46px);
		line-height: 1;
	}

	.count {
		flex: none;
		padding-bottom: 0.25em;
		color: var(--ink-faint);
		font-family: var(--font-mono);
		font-size: clamp(12px, 1vw, 15px);
		letter-spacing: 0.1em;
		transition: color 0.3s;
	}

	.list {
		margin: clamp(16px, 1.7vw, 26px) 0 0;
		padding: 0;
		list-style: none;
		color: var(--ink-body);
		font-family: var(--font-mono);
		font-size: clamp(12px, 0.95vw, 14px);
		line-height: 1.95;
	}

	/* Name on the left, a dimmer detail (such as a date) on the right */
	.stack li {
		display: flex;
		justify-content: space-between;
		gap: 1.5em;
		padding-block: 0.3em;
		line-height: 1.5;
	}

	.detail {
		flex: none;
		color: var(--ink-dim);
		letter-spacing: 0.04em;
	}

	/* Every item carries a dot in its left padding. The list is shifted left by that
	   padding and clipped there, so the dot of whichever item starts a line is hidden. */
	.inline {
		--dot-space: 2.3em;
		display: flex;
		flex-wrap: wrap;
		margin-left: calc(var(--dot-space) * -1);
		clip-path: inset(0 0 0 var(--dot-space));
	}

	.inline li {
		position: relative;
		padding-left: var(--dot-space);
	}

	.inline li::before {
		content: '•';
		position: absolute;
		left: 0;
		width: var(--dot-space);
		color: var(--ink-dim);
		text-align: center;
	}

	@media (hover: hover) and (pointer: fine) {
		.group:hover h3 {
			transform: translateY(-3px);
		}

		.group:hover .count {
			color: var(--green);
		}

		.group:hover .top {
			border-color: var(--ink-dim);
		}
	}

	@media (max-width: 720px) {
		.grid {
			grid-template-columns: minmax(0, 1fr);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		h3 {
			transition: none;
		}
	}
</style>
