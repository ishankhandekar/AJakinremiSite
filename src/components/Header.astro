---
import Terminal from './Terminal.astro';

// One link per page section; `section` is that section's id
const links = [
	{ label: 'Bio', section: 'about' },
	{ label: 'Work', section: 'experience' },
	{ label: 'Certs', section: 'certifications' },
	{ label: 'Stack', section: 'skills' },
	// Points at the first of the build sections; it stays marked through the ones after it
	{ label: 'Builds', section: 'projects' },
	{ label: 'Contact', section: 'contact' },
];
---

<header class="header">
	<a class="logo" href="/" aria-label="Anjola, home">
		<!-- "anjola" as a heavy geometric wordmark built from circles and straight stems -->
		<svg viewBox="0 0 70.5 23" width="70.5" height="23" aria-hidden="true">
			<g fill="none" stroke="currentColor" stroke-width="3">
				<circle cx="6.5" cy="11" r="5"></circle>
				<path d="M11.5 4.5v13"></path>
				<path d="M17 17.5v-13M17 11a5 5 0 0 1 10 0v6.5"></path>
				<path d="M32.5 4.5V17a4 4 0 0 1-4 4"></path>
				<circle cx="43" cy="11" r="5"></circle>
				<path d="M53.5 0v17.5"></path>
				<circle cx="64" cy="11" r="5"></circle>
				<path d="M69 4.5v13"></path>
			</g>
			<circle class="tittle" cx="32.5" cy="2.2" r="2.2"></circle>
		</svg>
	</a>

	<nav class="nav" aria-label="Primary">
		{
			links.map((link) => (
				<a href={`#${link.section}`} data-section={link.section}>
					<span class="marker" aria-hidden="true" />
					{link.label}
				</a>
			))
		}
	</nav>

	<div class="actions">
		<div class="tools">
			<button class="theme-button" type="button" aria-label="Switch to dark mode" data-tooltip="Dark mode" data-theme-toggle>
				<svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true">
					<mask id="theme-crescent">
						<rect width="24" height="24" fill="#fff"></rect>
						<circle class="bite" cx="17" cy="7" r="8" fill="#000"></circle>
					</mask>
					<g mask="url(#theme-crescent)">
						<circle class="core" cx="12" cy="12" r="4.2" fill="currentColor"></circle>
					</g>
					<g class="rays" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="butt">
						<path d="M12 1.4v3M12 19.6v3M1.4 12h3M19.6 12h3M4.5 4.5l2.12 2.12M17.38 17.38l2.12 2.12M4.5 19.5l2.12-2.12M17.38 6.62L19.5 4.5"></path>
					</g>
				</svg>
			</button>
			<button class="terminal-button" type="button" aria-label="Open terminal" data-tooltip="Open terminal" data-terminal-open>
				<svg viewBox="0 0 22 16" width="22" height="16" aria-hidden="true">
					<path d="M2 2.5l6.5 5.5L2 13.5" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="square" stroke-linejoin="miter"></path>
					<path class="cursor" d="M12 13.5h8" fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="square"></path>
				</svg>
			</button>
		</div>
		<a class="cta" href="/AJ-Akinremi-CV.pdf" download>
			<span>Download CV</span>
			<svg viewBox="0 0 12 12" width="11" height="11" aria-hidden="true">
				<path d="M6 1v7.5M2.5 5.5L6 9l3.5-3.5M1.5 11h9" fill="none" stroke="currentColor" stroke-width="1.2"></path>
			</svg>
		</a>
	</div>
</header>

<Terminal />

<script>
	const header = document.querySelector('.header');
	const update = () => header?.classList.toggle('scrolled', window.scrollY > 8);

	// Mark the nav link of whichever section has scrolled up past the middle of the screen
	const navLinks = [...document.querySelectorAll<HTMLAnchorElement>('.nav a[data-section]')];
	const spy = () => {
		// At the very bottom of the page a short last section can't reach the middle,
		// so there anything on screen counts
		const atBottom =
			window.innerHeight + window.scrollY >= document.documentElement.scrollHeight - 2;
		const line = window.innerHeight * (atBottom ? 1 : 0.45);
		let current: string | undefined;
		for (const link of navLinks) {
			const section = document.getElementById(link.dataset.section ?? '');
			if (section && section.getBoundingClientRect().top <= line) current = link.dataset.section;
		}
		for (const link of navLinks) {
			const active = link.dataset.section === current;
			link.classList.toggle('active', active);
			if (active) link.setAttribute('aria-current', 'true');
			else link.removeAttribute('aria-current');
		}
	};

	const onScroll = () => {
		update();
		spy();
	};

	onScroll();
	window.addEventListener('scroll', onScroll, { passive: true });
	window.addEventListener('resize', spy);

	const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
	const root = document.documentElement;
	const label = () => {
		const dark = root.classList.contains('dark');
		toggle?.setAttribute('aria-label', dark ? 'Switch to light mode' : 'Switch to dark mode');
		toggle?.setAttribute('data-tooltip', dark ? 'Light mode' : 'Dark mode');
	};

	label();

	// Until the visitor picks a theme here, keep following their device if it changes
	matchMedia('(prefers-color-scheme: dark)').addEventListener('change', (event) => {
		let saved = null;
		try {
			saved = localStorage.getItem('theme');
		} catch {}
		if (saved) return;
		root.classList.toggle('dark', event.matches);
		label();
	});

	toggle?.addEventListener('click', () => {
		const apply = () => {
			const dark = root.classList.toggle('dark');
			label();
			try {
				localStorage.setItem('theme', dark ? 'dark' : 'light');
			} catch {}
		};

		if (!document.startViewTransition || matchMedia('(prefers-reduced-motion: reduce)').matches) {
			apply();
			return;
		}

		// The new theme spreads across the page as a circle growing out of the button
		const rect = toggle.getBoundingClientRect();
		const x = rect.left + rect.width / 2;
		const y = rect.top + rect.height / 2;
		const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));

		document
			.startViewTransition(apply)
			.ready.then(() => {
				root.animate(
					{ clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
					{
						duration: 650,
						easing: 'cubic-bezier(0.65, 0, 0.35, 1)',
						pseudoElement: '::view-transition-new(root)',
					}
				);
			})
			// The browser skips the transition (e.g. in a background tab); the theme still switches
			.catch(() => {});
	});
</script>

<style>
	.header {
		position: fixed;
		inset: 0 0 auto 0;
		z-index: 10;
		display: flex;
		align-items: center;
		padding: clamp(20px, 2.2vw, 36px) clamp(20px, 4.8vw, 80px) clamp(20px, 2.2vw, 36px)
			clamp(20px, 5.4vw, 90px);
		font-size: clamp(13px, 1.1vw, 17px);
		transition:
			padding 0.3s ease,
			background-color 0.3s ease,
			box-shadow 0.3s ease;
	}

	.header.scrolled {
		padding-top: clamp(10px, 0.9vw, 14px);
		padding-bottom: clamp(10px, 0.9vw, 14px);
		background: var(--surface);
		box-shadow: 0 1px 0 var(--line);
	}

	.logo {
		display: flex;
		margin-right: clamp(28px, 4vw, 64px);
	}

	.logo svg {
		width: auto;
		height: clamp(21px, 1.8vw, 26px);
	}

	.logo .tittle {
		fill: var(--green);
	}

	.nav {
		display: flex;
		gap: clamp(18px, 2.2vw, 36px);
	}

	.nav a {
		display: inline-flex;
		align-items: center;
		text-decoration: underline;
		text-decoration-color: var(--ink-dim);
		text-decoration-thickness: 1px;
		text-underline-offset: 0.35em;
		transition:
			color 0.2s,
			text-decoration-color 0.2s;
	}

	.nav a.active {
		text-decoration-color: currentColor;
	}

	/* Green dot that pops in beside the link while its section is on screen.
	   It takes up no room until then, so the label slides over to make space. */
	.marker {
		position: relative;
		width: 0;
		height: 6px;
		margin-right: 0;
		border-radius: 50%;
		background: var(--green);
		opacity: 0;
		transform: scale(0);
		transition:
			width 0.45s cubic-bezier(0.22, 1, 0.36, 1),
			margin-right 0.45s cubic-bezier(0.22, 1, 0.36, 1),
			opacity 0.25s,
			transform 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.active .marker {
		width: 6px;
		margin-right: 0.6em;
		opacity: 1;
		transform: scale(1);
	}

	/* A single ripple as the dot lands */
	.active .marker::after {
		content: '';
		position: absolute;
		inset: 0;
		border-radius: 50%;
		background: var(--green);
		animation: marker-ripple 0.9s 0.15s ease-out both;
	}

	@keyframes marker-ripple {
		from {
			opacity: 0.5;
			transform: scale(1);
		}

		to {
			opacity: 0;
			transform: scale(3.6);
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.marker {
			transition: none;
		}

		.active .marker::after {
			animation: none;
			opacity: 0;
		}
	}

	@media (hover: hover) and (pointer: fine) {
		.nav a:hover {
			color: var(--green);
		}
	}

	.actions {
		display: flex;
		align-items: center;
		gap: clamp(14px, 1.8vw, 28px);
		margin-left: auto;
	}

	.tools {
		display: flex;
		align-items: center;
		gap: clamp(6px, 0.8vw, 12px);
	}

	/* Small label under each icon button, on hover (mouse only) or keyboard focus */
	.tools button {
		position: relative;
	}

	.tools button::after {
		content: attr(data-tooltip);
		position: absolute;
		top: calc(100% + 8px);
		left: 50%;
		padding: 0.45em 0.75em;
		border-radius: 6px;
		background: var(--ink);
		color: var(--bg);
		font-family: var(--font-sans);
		font-size: 12px;
		line-height: 1.2;
		white-space: nowrap;
		opacity: 0;
		pointer-events: none;
		translate: -50% -4px;
		transition:
			opacity 0.15s,
			translate 0.15s;
	}

	.tools button:focus-visible::after {
		opacity: 1;
		translate: -50% 0;
	}

	@media (hover: hover) and (pointer: fine) {
		.tools button:hover::after {
			opacity: 1;
			translate: -50% 0;
			transition-delay: 0.3s;
		}
	}

	.theme-button {
		display: grid;
		place-items: center;
		padding: 0.4em;
		color: var(--ink);
		cursor: pointer;
	}

	/* Sun: small disc with rays. Moon: the disc grows, a second circle bites a
	   crescent out of it, and the rays spin away. */
	.theme-button svg {
		overflow: visible;
		transition:
			transform 0.7s cubic-bezier(0.34, 1.56, 0.64, 1),
			opacity 0.2s;
	}

	.theme-button .core,
	.theme-button .rays {
		transform-box: fill-box;
		transform-origin: center;
	}

	.theme-button .core {
		transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.theme-button .bite {
		transform: translate(11px, -11px);
		transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.theme-button .rays {
		transition:
			transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1),
			opacity 0.35s;
	}

	:global(.dark) .theme-button svg {
		transform: rotate(-30deg);
	}

	:global(.dark) .theme-button .core {
		transform: scale(1.8);
	}

	:global(.dark) .theme-button .bite {
		transform: none;
	}

	:global(.dark) .theme-button .rays {
		opacity: 0;
		transform: rotate(90deg) scale(0.4);
	}

	@media (hover: hover) and (pointer: fine) {
		.theme-button:hover svg {
			opacity: 0.65;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.theme-button svg,
		.theme-button svg * {
			transition: none;
		}
	}

	.terminal-button {
		display: grid;
		place-items: center;
		padding: 0.4em;
		color: var(--green);
		cursor: pointer;
	}

	.terminal-button svg {
		transition: opacity 0.2s;
	}

	@media (hover: hover) and (pointer: fine) {
		.terminal-button:hover svg {
			opacity: 0.65;
		}
	}

	.terminal-button .cursor {
		animation: blink 1.1s steps(1) infinite;
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.terminal-button .cursor {
			animation: none;
		}
	}

	.cta {
		display: flex;
		align-items: center;
		gap: 0.5em;
	}

	.cta span {
		text-decoration: underline;
		text-decoration-color: var(--green);
		text-underline-offset: 0.2em;
		text-decoration-thickness: 2px;
	}

	.cta svg {
		color: var(--green);
		transition: transform 0.2s;
	}

	@media (hover: hover) and (pointer: fine) {
		.cta:hover svg {
			transform: translateY(2px);
		}
	}

	@media (max-width: 720px) {
		.nav {
			display: none;
		}

		/* Keep the right-hand cluster small and tucked into the corner */
		.header {
			padding-right: 12px;
		}

		.actions {
			gap: 8px;
		}

		.tools {
			gap: 0;
		}

		.theme-button svg {
			width: 15px;
			height: 15px;
		}

		.terminal-button svg {
			width: 17px;
			height: 12px;
		}

		.cta {
			gap: 0.35em;
			font-size: 12px;
		}

		.cta span {
			text-decoration-thickness: 1px;
		}

		.cta svg {
			width: 9px;
			height: 9px;
		}
	}
</style>
