---
import Terminal from './Terminal.astro';

const links = [
	{ label: 'About Me', href: '#about' },
	{ label: 'Portfolio', href: '#portfolio' },
	{ label: 'Services', href: '#services' },
	{ label: 'Blog', href: '#blog' },
];
---

<header class="header">
	<a class="logo" href="/" aria-label="Home">
		<!-- Placeholder mark: swap for the client's logo -->
		<svg viewBox="0 0 28 24" width="28" height="24" aria-hidden="true">
			<path
				fill="currentColor"
				d="M1 1l8 5 5-3 5 3 8-5-4 13-9 9-9-9zM9.5 12.5l2.5 2.5-3.5-.5zM18.5 12.5L16 15l3.5-.5z"
				fill-rule="evenodd"></path>
		</svg>
	</a>

	<nav class="nav" aria-label="Primary">
		{links.map((link) => <a href={link.href}>{link.label}</a>)}
	</nav>

	<div class="actions">
		<div class="tools">
			<button class="theme-button" type="button" aria-label="Switch to dark mode" data-theme-toggle>
				<svg viewBox="0 0 24 24" width="20" height="20" aria-hidden="true">
					<mask id="theme-crescent">
						<rect width="24" height="24" fill="#fff"></rect>
						<circle class="bite" cx="17" cy="7" r="8" fill="#000"></circle>
					</mask>
					<g mask="url(#theme-crescent)">
						<circle class="core" cx="12" cy="12" r="5" fill="currentColor"></circle>
					</g>
					<g class="rays" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
						<path d="M12 1.5v2.5M12 20v2.5M1.5 12H4M20 12h2.5M4.6 4.6l1.8 1.8M17.6 17.6l1.8 1.8M4.6 19.4l1.8-1.8M17.6 6.4l1.8-1.8"></path>
					</g>
				</svg>
			</button>
			<button class="terminal-button" type="button" aria-label="Open terminal" data-terminal-open>
				<svg viewBox="0 0 22 16" width="22" height="16" aria-hidden="true">
					<path d="M2 3l6 5-6 5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
					<path class="cursor" d="M12 14h8" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
				</svg>
			</button>
		</div>
		<a class="cta" href="#contact">
			<span>Contact Me</span>
			<svg viewBox="0 0 12 12" width="11" height="11" aria-hidden="true">
				<path d="M2 10L10 2M3.5 2H10v6.5" fill="none" stroke="currentColor" stroke-width="1.2"></path>
			</svg>
		</a>
	</div>
</header>

<Terminal />

<script>
	const header = document.querySelector('.header');
	const update = () => header?.classList.toggle('scrolled', window.scrollY > 8);

	update();
	window.addEventListener('scroll', update, { passive: true });

	const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
	const root = document.documentElement;
	const label = () =>
		toggle?.setAttribute(
			'aria-label',
			root.classList.contains('dark') ? 'Switch to light mode' : 'Switch to dark mode'
		);

	label();
	toggle?.addEventListener('click', () => {
		const apply = () => {
			const dark = root.classList.toggle('dark');
			label();
			try {
				localStorage.setItem('theme', dark ? 'dark' : 'light');
			} catch {}
		};

		if (!document.startViewTransition || matchMedia('(prefers-reduced-motion: reduce)').matches) {
			apply();
			return;
		}

		// The new theme spreads across the page as a circle growing out of the button
		const rect = toggle.getBoundingClientRect();
		const x = rect.left + rect.width / 2;
		const y = rect.top + rect.height / 2;
		const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));

		document
			.startViewTransition(apply)
			.ready.then(() => {
				root.animate(
					{ clipPath: [`circle(0px at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
					{
						duration: 650,
						easing: 'cubic-bezier(0.65, 0, 0.35, 1)',
						pseudoElement: '::view-transition-new(root)',
					}
				);
			})
			// The browser skips the transition (e.g. in a background tab); the theme still switches
			.catch(() => {});
	});
</script>

<style>
	.header {
		position: fixed;
		inset: 0 0 auto 0;
		z-index: 10;
		display: flex;
		align-items: center;
		padding: clamp(20px, 2.2vw, 36px) clamp(20px, 4.8vw, 80px) clamp(20px, 2.2vw, 36px)
			clamp(20px, 5.4vw, 90px);
		font-size: clamp(13px, 1.1vw, 17px);
		transition:
			padding 0.3s ease,
			background-color 0.3s ease,
			box-shadow 0.3s ease;
	}

	.header.scrolled {
		padding-top: clamp(10px, 0.9vw, 14px);
		padding-bottom: clamp(10px, 0.9vw, 14px);
		background: var(--surface);
		box-shadow: 0 1px 0 var(--line);
	}

	.logo {
		display: flex;
		margin-right: clamp(28px, 4vw, 64px);
	}

	.logo svg {
		width: clamp(26px, 2.6vw, 38px);
		height: auto;
	}

	.nav {
		display: flex;
		gap: clamp(18px, 2.2vw, 36px);
	}

	.nav a {
		transition: color 0.2s;
	}

	@media (hover: hover) and (pointer: fine) {
		.nav a:hover {
			color: var(--green);
		}
	}

	.actions {
		display: flex;
		align-items: center;
		gap: clamp(14px, 1.8vw, 28px);
		margin-left: auto;
	}

	.tools {
		display: flex;
		align-items: center;
		gap: clamp(6px, 0.8vw, 12px);
	}

	.theme-button {
		display: grid;
		place-items: center;
		padding: 0.4em;
		color: var(--ink);
		cursor: pointer;
		transition: opacity 0.2s;
	}

	/* Sun: small disc with rays. Moon: the disc grows, a second circle bites a
	   crescent out of it, and the rays spin away. */
	.theme-button svg {
		overflow: visible;
		transition: transform 0.7s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.theme-button .core,
	.theme-button .rays {
		transform-box: fill-box;
		transform-origin: center;
	}

	.theme-button .core {
		transition: transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1);
	}

	.theme-button .bite {
		transform: translate(11px, -11px);
		transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.theme-button .rays {
		transition:
			transform 0.6s cubic-bezier(0.34, 1.56, 0.64, 1),
			opacity 0.35s;
	}

	:global(.dark) .theme-button svg {
		transform: rotate(-30deg);
	}

	:global(.dark) .theme-button .core {
		transform: scale(1.8);
	}

	:global(.dark) .theme-button .bite {
		transform: none;
	}

	:global(.dark) .theme-button .rays {
		opacity: 0;
		transform: rotate(90deg) scale(0.4);
	}

	@media (hover: hover) and (pointer: fine) {
		.theme-button:hover {
			opacity: 0.65;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.theme-button svg,
		.theme-button svg * {
			transition: none;
		}
	}

	.terminal-button {
		display: grid;
		place-items: center;
		padding: 0.4em;
		color: var(--green);
		cursor: pointer;
		transition: opacity 0.2s;
	}

	@media (hover: hover) and (pointer: fine) {
		.terminal-button:hover {
			opacity: 0.65;
		}
	}

	.terminal-button .cursor {
		animation: blink 1.1s steps(1) infinite;
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.terminal-button .cursor {
			animation: none;
		}
	}

	.cta {
		display: flex;
		align-items: center;
		gap: 0.5em;
	}

	.cta span {
		text-decoration: underline;
		text-decoration-color: var(--green);
		text-underline-offset: 0.2em;
		text-decoration-thickness: 2px;
	}

	.cta svg {
		color: var(--green);
		transition: transform 0.2s;
	}

	@media (hover: hover) and (pointer: fine) {
		.cta:hover svg {
			transform: translate(2px, -2px);
		}
	}

	@media (max-width: 720px) {
		.nav {
			display: none;
		}

		/* Keep the right-hand cluster small and tucked into the corner */
		.header {
			padding-right: 12px;
		}

		.actions {
			gap: 8px;
		}

		.tools {
			gap: 0;
		}

		.theme-button svg {
			width: 15px;
			height: 15px;
		}

		.terminal-button svg {
			width: 17px;
			height: 12px;
		}

		.cta {
			gap: 0.35em;
			font-size: 12px;
		}

		.cta span {
			text-decoration-thickness: 1px;
		}

		.cta svg {
			width: 9px;
			height: 9px;
		}
	}
</style>
