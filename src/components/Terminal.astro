---
import { statSync } from 'node:fs';
import { join } from 'node:path';
import { projects } from '../data/projects';

// A line of output: plain text, or text that links somewhere and/or is tinted
type Line = string | { text: string; href?: string; tone?: 'accent' | 'dim' };

const resume = '/AJ-Akinremi-CV.pdf';
const resumeKb = Math.round(statSync(join(process.cwd(), 'public', resume)).size / 1024);

// Everything here is drawn from AJ's CV and the rest of the site
const links = {
	email: { label: 'aj.akinremi@yahoo.com', href: 'mailto:aj.akinremi@yahoo.com' },
	linkedin: { label: 'linkedin.com/in/aj-akinremi', href: 'https://www.linkedin.com/in/aj-akinremi/' },
	github: { label: 'github.com/thecenturist', href: 'https://github.com/thecenturist' },
	resume: { label: `AJ-Akinremi-CV.pdf (${resumeKb} kB)`, href: resume },
};

const commands: Record<string, Line[]> = {
	about: [
		'Anjolaoluwa "AJ" Akinremi, Senior Technical Support Engineer at Stryker, San Diego, CA.',
		'Started on the help desk in 2020. Now manages 230+ Linux servers and builds the automation that keeps them running.',
		'Studying for a BSc in Computer Science at San Diego Mesa College.',
	],
	whoami: ['aj  (Anjolaoluwa Akinremi), senior technical support engineer, san diego, ca'],
	experience: [
		{ text: '2022 - now   Stryker (formerly Vocera Communications)', tone: 'accent' },
		'             Senior Technical Support Engineer',
		{ text: '2021 - 2022  SkyRiver IT', tone: 'accent' },
		'             Remote Support Technician',
		{ text: '2020 - 2021  Global Equity Finance', tone: 'accent' },
		'             IT HelpDesk Technician',
	],
	projects: projects.map((project) => ({
		text: `${project.title.padEnd(36)}/projects/${project.slug}`,
		href: `/projects/${project.slug}`,
	})),
	certs: [
		'20 industry certifications:',
		'  aws        Solutions Architect, Developer, SysOps Administrator, DevOps Engineer Professional',
		'  red hat    RHCSA, RHCE: Ansible Automation, Containers, Services Management and Automation',
		'  comptia    A+, Network+, Security+, Linux+, PenTest+',
		'  hashicorp  Terraform Associate, Vault Associate',
		'  python     Certified Entry-Level Programmer, Certified Associate in Python',
		'  microsoft  Azure Administrator Associate',
		'  cisco      Certified Network Associate',
		'  oracle     Java Certified Foundations Associate',
	],
	stack: [
		'  os           CentOS, RHEL, Oracle Linux',
		'  automation   Python, Bash, NodeJS, Ansible',
		'  infra        Zookeeper, Kafka, Vault, Docker, systemd',
		'  databases    MySQL, MSSQL',
		'  security     SSL/certificate management, SAML, LDAP',
		'  integration  HL7',
	],
	history: [
		'    1  helpdesk --employer "Global Equity Finance"    # 2020',
		'    2  ansible-playbook news-displays.yml             # 7-server linux environment',
		'    3  python3 deploy_workstations.py                 # 85% faster deployments',
		'    4  remote-support --employer "SkyRiver IT"        # 2021',
		'    5  systemctl start support-engineer@stryker       # 2022',
		'    6  ./ssl2ool                                      # oct 2023',
		'    7  ./multi-ssh                                    # jan 2024',
		'    8  history',
	],
	contact: [
		{ text: `email     ${links.email.label}`, href: links.email.href },
		{ text: `linkedin  ${links.linkedin.label}`, href: links.linkedin.href },
		{ text: `github    ${links.github.label}`, href: links.github.href },
	],
	ls: ['about.txt   contact.txt   experience.txt   stack.txt   certs/   projects/   resume.pdf'],
	pwd: ['/home/aj'],
	help: [
		'about        who AJ is              whoami      the short version',
		'experience   where AJ has worked    projects    things AJ has built',
		'certs        certifications         stack       tools AJ uses daily',
		'neofetch     system info            uptime      time in IT',
		'history      career, as a shell     contact     how to reach AJ',
		'resume       download the CV        open <x>    email, linkedin, github, resume',
		'ls, cat, pwd, echo, date            clear       exit',
		{ text: 'Tab completes, ↑ and ↓ recall earlier commands, Ctrl+C stops output, Ctrl+L clears.', tone: 'dim' },
	],
};

// The prebaked commands along the bottom
const buttons = [
	'about',
	'whoami',
	'neofetch',
	'experience',
	'projects',
	'certs',
	'stack',
	'uptime',
	'history',
	'ls',
	'resume',
	'contact',
	'help',
];

const intro: Line[] = [
	'Hi, I’m AJ. Click a command below, or type one and hit enter.',
	{ text: 'Tab completes, ↑ and ↓ recall earlier commands, help lists everything.', tone: 'dim' },
];

const config = { commands, links, intro };
---

<dialog class="terminal" aria-label="Terminal" data-terminal data-lenis-prevent data-config={JSON.stringify(config)}>
	<div class="window">
		<div class="bar">
			<span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
			<span class="title">aj@portfolio: ~</span>
			<button class="close" type="button" data-terminal-close>esc</button>
		</div>

		<div class="output" data-output aria-live="polite"></div>

		<form class="prompt" data-prompt>
			<span class="ps1" aria-hidden="true">$</span>
			<input
				type="text"
				name="command"
				placeholder="type a command"
				aria-label="Command"
				autocomplete="off"
				autocapitalize="off"
				spellcheck="false"
			/>
		</form>
	</div>

	<div class="commands">
		{
			buttons.map((command, index) => (
				<button type="button" data-command={command} style={`--i: ${index}`}>
					{command}
				</button>
			))
		}
	</div>
</dialog>

<script>
	type Line = string | { text: string; href?: string; tone?: 'accent' | 'dim' };
	interface Config {
		commands: Record<string, Line[]>;
		links: Record<string, { label: string; href: string }>;
		intro: Line[];
	}

	const dialog = document.querySelector<HTMLDialogElement>('[data-terminal]');
	const output = dialog?.querySelector<HTMLElement>('[data-output]');
	const form = dialog?.querySelector<HTMLFormElement>('[data-prompt]');
	const input = form?.querySelector<HTMLInputElement>('input');

	if (dialog && output && form && input) {
		const { commands, links, intro }: Config = JSON.parse(dialog.dataset.config ?? '{}');
		const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
		// Don't pop the on-screen keyboard open on touch devices
		const finePointer = matchMedia('(hover: hover) and (pointer: fine)').matches;

		// Files that `ls` lists and `cat` prints
		const files: Record<string, string> = {
			'about.txt': 'about',
			'contact.txt': 'contact',
			'experience.txt': 'experience',
			'stack.txt': 'stack',
		};
		const folders: Record<string, string> = { certs: 'certs', projects: 'projects' };

		// Commands worked out when they run, rather than fixed text
		const careerStart = new Date(2020, 0, 1);

		const uptime = () => {
			const now = new Date();
			const months =
				(now.getFullYear() - careerStart.getFullYear()) * 12 + now.getMonth() - careerStart.getMonth();
			const years = Math.floor(months / 12);
			const rest = months % 12;
			return `${years} year${years === 1 ? '' : 's'}, ${rest} month${rest === 1 ? '' : 's'}`;
		};

		const neofetch = (): Line[] => {
			const art = ['  \\\\      ', '   \\\\     ', '    >>    ', '   //     ', '  // ____ ', '          '];
			const info = [
				'aj@portfolio',
				'------------',
				'os        RHEL, CentOS, Oracle Linux',
				'role      Senior Technical Support Engineer',
				'employer  Stryker',
				`uptime    ${uptime()}`,
				'shell     bash, python',
				'certs     20',
				'location  San Diego, CA',
			];
			// Phones are too narrow for the logo beside the details, so it goes above them
			const narrow = matchMedia('(max-width: 720px)').matches;
			const tone = (index: number) => (index < 2 ? ('accent' as const) : undefined);
			if (narrow) {
				return [
					...art.slice(0, 5).map((text) => ({ text, tone: 'accent' as const })),
					...info.map((text, index) => ({ text, tone: tone(index) })),
				];
			}
			return info.map((text, index) => ({
				text: `${(art[index] ?? '          ').padEnd(12)}${text}`,
				tone: tone(index),
			}));
		};

		const builtins = [
			'cat',
			'clear',
			'date',
			'echo',
			'exit',
			'neofetch',
			'open',
			'resume',
			'uptime',
		];
		const allCommands = [...new Set([...Object.keys(commands), ...builtins])].sort();

		let opener: HTMLElement | null = null;
		let queue = Promise.resolve();
		// Bumped to make whatever is typing finish instantly
		let generation = 0;
		let interrupted = false;

		// Earlier commands, for the arrow keys
		const history: string[] = [];
		let historyIndex = 0;
		let draft = '';

		const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
		const scrollToEnd = () => (output.scrollTop = output.scrollHeight);

		const addLine = (className: string, text = '') => {
			const line = document.createElement('p');
			line.className = className;
			line.textContent = text;
			output.append(line);
			scrollToEnd();
			return line;
		};

		const type = async (lines: Line[], className = 'line') => {
			const mine = generation;
			// Long answers type faster so they don't drag
			const step = lines.length > 6 ? 5 : 2;
			for (const line of lines) {
				const spec = typeof line === 'string' ? { text: line } : line;
				const element = addLine(`${className} typing ${spec.tone ?? ''}`.trim());
				let target: HTMLElement = element;
				if (spec.href) {
					const link = document.createElement('a');
					link.href = spec.href;
					if (spec.href.startsWith('http')) {
						link.target = '_blank';
						link.rel = 'noopener';
					}
					target = element.appendChild(link);
				}
				for (let i = 0; i < spec.text.length; i += step) {
					if (mine !== generation || reducedMotion) break;
					target.textContent = spec.text.slice(0, i + step);
					scrollToEnd();
					await sleep(22);
				}
				target.textContent = spec.text;
				element.classList.remove('typing');
				scrollToEnd();
				if (mine === generation && !reducedMotion) await sleep(60);
			}
		};

		const enqueue = (task: () => Promise<void> | void) => {
			generation++;
			queue = queue.then(task);
		};

		// Closest known command, for "did you mean"
		const distance = (a: string, b: string) => {
			const row = Array.from({ length: b.length + 1 }, (_, i) => i);
			for (let i = 1; i <= a.length; i++) {
				let previous = row[0];
				row[0] = i;
				for (let j = 1; j <= b.length; j++) {
					const current = row[j];
					row[j] = Math.min(row[j] + 1, row[j - 1] + 1, previous + (a[i - 1] === b[j - 1] ? 0 : 1));
					previous = current;
				}
			}
			return row[b.length];
		};

		const suggest = (name: string) => {
			let best = '';
			let bestScore = Infinity;
			for (const candidate of allCommands) {
				const score = distance(name, candidate);
				if (score < bestScore) [best, bestScore] = [candidate, score];
			}
			return bestScore <= 2 ? best : '';
		};

		const download = (href: string) => {
			const link = document.createElement('a');
			link.href = href;
			link.download = '';
			link.click();
		};

		const openTarget = (target: string): Line[] => {
			const link = links[target];
			if (!link) return [`open: ${target || 'nothing'}: try email, linkedin, github or resume`];
			if (target === 'resume') download(link.href);
			else if (link.href.startsWith('mailto:')) location.href = link.href;
			else window.open(link.href, '_blank', 'noopener');
			return [{ text: `opening ${link.label}`, tone: 'dim' }];
		};

		const execute = (command: string): Line[] | 'clear' | 'exit' => {
			const [name, ...args] = command.split(/\s+/);
			const arg = args.join(' ');
			const key = name.toLowerCase();

			switch (key) {
				case 'clear':
					return 'clear';
				case 'exit':
					return 'exit';
				case 'neofetch':
					return neofetch();
				case 'uptime': {
					const time = new Date().toLocaleTimeString('en-GB');
					return [`${time} up ${uptime()},  1 user,  load average: 0.08, 0.03, 0.01`];
				}
				case 'date':
					return [new Date().toString()];
				case 'echo':
					return [arg];
				case 'resume':
					return openTarget('resume');
				case 'open':
					return openTarget(arg.toLowerCase());
				case 'cat': {
					const file = arg.toLowerCase();
					if (files[file]) return commands[files[file]];
					if (file === 'resume.pdf') return ['cat: resume.pdf: binary file, try: resume'];
					if (folders[file.replace(/\/$/, '')]) return [`cat: ${file}: Is a directory`];
					return [`cat: ${arg || 'missing file name'}: No such file or directory`];
				}
				case 'ls': {
					const folder = folders[arg.toLowerCase().replace(/\/$/, '')];
					return folder ? commands[folder] : commands.ls;
				}
			}

			if (key in commands) return commands[key];

			const guess = suggest(key);
			return [
				{ text: 'command not found, type help for a list of commands', tone: undefined },
				...(guess ? [{ text: `did you mean: ${guess}`, tone: 'dim' as const }] : []),
			];
		};

		const run = (raw: string) => {
			const command = raw.trim();
			if (!command) return;
			if (history[history.length - 1] !== command) history.push(command);
			historyIndex = history.length;

			enqueue(async () => {
				interrupted = false;
				addLine('echo', `$ ${command}`);

				const result = execute(command);
				if (result === 'clear') return output.replaceChildren();
				if (result === 'exit') return close();
				const known = !(typeof result[0] === 'object' && result[0].text.startsWith('command not found'));
				await type(result, known ? 'line' : 'line error');
			});
		};

		// Tab completion: fill in the one match, or the shared part of several and list them
		const complete = () => {
			const value = input.value;
			const parts = value.split(/\s+/);
			const completingArgument = parts.length > 1;
			const word = parts[parts.length - 1].toLowerCase();
			const pool = !completingArgument
				? allCommands
				: parts[0] === 'open'
					? Object.keys(links)
					: parts[0] === 'cat' || parts[0] === 'ls'
						? [...Object.keys(files), ...Object.keys(folders).map((f) => `${f}/`), 'resume.pdf']
						: [];
			const matches = pool.filter((candidate) => candidate.startsWith(word));
			if (!matches.length) return;

			let shared = matches[0];
			for (const match of matches) {
				while (!match.startsWith(shared)) shared = shared.slice(0, -1);
			}
			const filled = matches.length === 1 ? `${matches[0]}${completingArgument ? '' : ' '}` : shared;
			parts[parts.length - 1] = filled;
			input.value = parts.join(' ');

			if (matches.length > 1 && shared === word) {
				addLine('echo', `$ ${value}`);
				addLine('line dim', matches.join('   '));
			}
		};

		input.addEventListener('keydown', (event) => {
			if (event.key === 'Tab') {
				event.preventDefault();
				complete();
			} else if (event.key === 'ArrowUp') {
				if (!history.length) return;
				event.preventDefault();
				if (historyIndex === history.length) draft = input.value;
				historyIndex = Math.max(0, historyIndex - 1);
				input.value = history[historyIndex];
			} else if (event.key === 'ArrowDown') {
				if (historyIndex >= history.length) return;
				event.preventDefault();
				historyIndex += 1;
				input.value = historyIndex === history.length ? draft : history[historyIndex];
			} else if (event.ctrlKey && event.key.toLowerCase() === 'l') {
				event.preventDefault();
				generation++;
				output.replaceChildren();
			} else if (
				event.ctrlKey &&
				event.key.toLowerCase() === 'c' &&
				input.selectionStart === input.selectionEnd
			) {
				// Like a real shell: stop the output and abandon the current line
				event.preventDefault();
				generation++;
				if (!interrupted) {
					addLine('echo', `$ ${input.value}^C`);
					interrupted = true;
				}
				input.value = '';
			}
		});

		const open = (from: HTMLElement) => {
			if (dialog.open) return;
			opener = from;

			const rect = from.getBoundingClientRect();
			dialog.style.setProperty('--x', `${rect.left + rect.width / 2}px`);
			dialog.style.setProperty('--y', `${rect.top + rect.height / 2}px`);

			output.replaceChildren();
			dialog.showModal();
			// Let the closed state paint first so the reveal transitions
			requestAnimationFrame(() => requestAnimationFrame(() => (dialog.dataset.state = 'open')));

			enqueue(async () => {
				if (!reducedMotion) await sleep(450);
				await type(intro);
			});
			if (finePointer) input.focus();
		};

		const close = () => {
			if (!dialog.open || dialog.dataset.state === 'closing') return;
			generation++;
			dialog.dataset.state = 'closing';
			setTimeout(
				() => {
					dialog.close();
					delete dialog.dataset.state;
					opener?.focus();
				},
				reducedMotion ? 0 : 450
			);
		};

		document.querySelectorAll<HTMLElement>('[data-terminal-open]').forEach((button) => {
			button.addEventListener('click', () => open(button));
		});

		dialog.querySelector('[data-terminal-close]')?.addEventListener('click', close);
		dialog.addEventListener('cancel', (event) => {
			event.preventDefault();
			close();
		});

		dialog.querySelectorAll<HTMLElement>('[data-command]').forEach((button) => {
			button.addEventListener('click', () => {
				run(button.dataset.command ?? '');
				if (finePointer) input.focus();
			});
		});

		form.addEventListener('submit', (event) => {
			event.preventDefault();
			run(input.value);
			input.value = '';
		});

		output.addEventListener('click', (event) => {
			if ((event.target as HTMLElement).closest('a')) return;
			if (finePointer && !getSelection()?.toString()) input.focus();
		});
	}
</script>

<style>
	.terminal {
		--edge: #2a2a2a;
		position: fixed;
		inset: 0;
		width: 100vw;
		max-width: none;
		height: 100dvh;
		max-height: none;
		margin: 0;
		padding: clamp(12px, 2.4vw, 40px);
		border: 0;
		background: #070707;
		color: #d8d8d8;
		font-family: var(--font-mono);
		clip-path: circle(0 at var(--x, 100%) var(--y, 0));
		transition: clip-path 0.65s cubic-bezier(0.65, 0, 0.35, 1);
	}

	.terminal[open] {
		display: flex;
		flex-direction: column;
		gap: clamp(12px, 1.4vw, 20px);
	}

	.terminal[data-state='open'] {
		clip-path: circle(150vmax at var(--x, 100%) var(--y, 0));
	}

	.terminal[data-state='closing'] {
		transition-duration: 0.45s;
	}

	.terminal::backdrop {
		background: transparent;
	}

	:global(html:has(.terminal[open])) {
		overflow: hidden;
	}

	.window {
		display: flex;
		flex: 1;
		flex-direction: column;
		min-height: 0;
		overflow: hidden;
		border: 1px solid var(--edge);
		border-radius: 14px;
		background: #111;
		opacity: 0;
		transform: translateY(14px) scale(0.985);
		transition:
			opacity 0.3s,
			transform 0.3s;
	}

	[data-state='open'] .window {
		opacity: 1;
		transform: none;
		transition:
			opacity 0.45s 0.2s,
			transform 0.6s 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
	}

	.bar {
		display: flex;
		align-items: center;
		gap: 16px;
		padding: 12px 16px;
		border-bottom: 1px solid var(--edge);
		color: #8a8a8a;
		font-size: 13px;
	}

	.dots {
		display: flex;
		gap: 7px;
	}

	.dots i {
		width: 11px;
		height: 11px;
		border-radius: 50%;
		background: #3a3a3a;
	}

	.close {
		margin-left: auto;
		padding: 0.2em 0.7em;
		border: 1px solid var(--edge);
		border-radius: 6px;
		color: inherit;
		font: inherit;
		cursor: pointer;
		transition:
			border-color 0.2s,
			color 0.2s;
	}

	@media (hover: hover) and (pointer: fine) {
		.close:hover {
			border-color: #4a4a4a;
			color: #d8d8d8;
		}
	}

	.output {
		flex: 1;
		overflow-y: auto;
		padding: clamp(16px, 2vw, 28px) clamp(16px, 2vw, 28px) 8px;
		font-size: clamp(13px, 1.15vw, 17px);
		line-height: 1.75;
	}

	.output :global(p) {
		min-height: 1.75em;
		margin: 0;
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}

	.output :global(.echo) {
		margin-top: 1em;
		color: var(--green);
	}

	.output :global(.accent) {
		color: #3ee07f;
	}

	.output :global(.error) {
		color: #f87171;
	}

	/* After .error, so a "did you mean" hint under an error stays grey */
	.output :global(.dim) {
		color: #7a7a7a;
	}

	.output :global(a) {
		color: inherit;
		text-decoration: underline;
		text-decoration-color: #4a4a4a;
		text-underline-offset: 0.25em;
	}

	@media (hover: hover) and (pointer: fine) {
		.output :global(a:hover) {
			color: #3ee07f;
			text-decoration-color: currentColor;
		}
	}

	.output :global(.typing)::after {
		content: '';
		display: inline-block;
		width: 0.55em;
		height: 1.05em;
		margin-left: 2px;
		background: var(--green);
		vertical-align: text-bottom;
	}

	.prompt {
		display: flex;
		align-items: center;
		gap: 14px;
		padding: 12px clamp(16px, 2vw, 28px) clamp(16px, 2vw, 24px);
		font-size: clamp(13px, 1.15vw, 17px);
	}

	.ps1 {
		color: var(--green);
	}

	.prompt input {
		flex: 1;
		min-width: 0;
		border: 0;
		outline: 0;
		background: none;
		color: inherit;
		font: inherit;
		caret-color: var(--green);
	}

	.prompt input::placeholder {
		color: #5e5e5e;
	}

