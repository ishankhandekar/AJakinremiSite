---
// Placeholder copy: swap for AJ's real answers
const commands: Record<string, string[]> = {
	about: [
		'Anjolaoluwa "AJ" Akinremi — Senior Technical Support Engineer, San Diego, CA.',
		'[placeholder] A short bio goes here: what AJ does, what he cares about, and what he is looking for next.',
	],
	certs: [
		'20 industry certifications:',
		'  aws        Solutions Architect, Developer, SysOps Administrator, DevOps Engineer Professional',
		'  red hat    RHCSA, RHCE: Ansible Automation, Containers, Services Management and Automation',
		'  comptia    A+, Network+, Security+, Linux+, PenTest+',
		'  hashicorp  Terraform Associate, Vault Associate',
		'  python     Certified Entry-Level Programmer, Certified Associate in Python',
		'  microsoft  Azure Administrator Associate',
		'  cisco      Certified Network Associate',
		'  oracle     Java Certified Foundations Associate',
	],
	projects: [
		'[placeholder] project-one    A one-line description of the first project.',
		'[placeholder] project-two    A one-line description of the second project.',
		'[placeholder] project-three  A one-line description of the third project.',
	],
	contact: [
		'[placeholder] email     aj@example.com',
		'[placeholder] linkedin  linkedin.com/in/placeholder',
		'[placeholder] github    github.com/placeholder',
	],
	help: [
		'Available commands:',
		'  about     who AJ is',
		'  certs     certifications',
		'  projects  things AJ has built',
		'  contact   how to reach AJ',
		'  clear     clear the screen',
		'  exit      close the terminal',
	],
};

const buttons = ['about', 'certs', 'projects', 'contact', 'help'];
const intro = [
	'Hi, I’m AJ. Click a command below, or type one and hit enter.',
	`Try: ${buttons.join(', ')}`,
];
---

<dialog class="terminal" aria-label="Terminal" data-terminal data-lenis-prevent data-commands={JSON.stringify(commands)} data-intro={JSON.stringify(intro)}>
	<div class="window">
		<div class="bar">
			<span class="dots" aria-hidden="true"><i></i><i></i><i></i></span>
			<span class="title">aj@portfolio: ~</span>
			<button class="close" type="button" data-terminal-close>esc</button>
		</div>

		<div class="output" data-output aria-live="polite"></div>

		<form class="prompt" data-prompt>
			<span class="ps1" aria-hidden="true">$</span>
			<input
				type="text"
				name="command"
				placeholder="type a command"
				aria-label="Command"
				autocomplete="off"
				autocapitalize="off"
				spellcheck="false"
			/>
		</form>
	</div>

	<div class="commands">
		{
			buttons.map((command) => (
				<button type="button" data-command={command}>
					{command}
				</button>
			))
		}
	</div>
</dialog>

<script>
	const dialog = document.querySelector<HTMLDialogElement>('[data-terminal]');
	const output = dialog?.querySelector<HTMLElement>('[data-output]');
	const form = dialog?.querySelector<HTMLFormElement>('[data-prompt]');
	const input = form?.querySelector<HTMLInputElement>('input');

	if (dialog && output && form && input) {
		const commands: Record<string, string[]> = JSON.parse(dialog.dataset.commands ?? '{}');
		const intro: string[] = JSON.parse(dialog.dataset.intro ?? '[]');
		const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
		// Don't pop the on-screen keyboard open on touch devices
		const finePointer = matchMedia('(hover: hover) and (pointer: fine)').matches;

		let opener: HTMLElement | null = null;
		let queue = Promise.resolve();
		// Bumped to make whatever is typing finish instantly
		let generation = 0;

		const sleep = (ms: number) => new Promise((resolve) => setTimeout(resolve, ms));
		const scrollToEnd = () => (output.scrollTop = output.scrollHeight);

		const addLine = (className: string, text = '') => {
			const line = document.createElement('p');
			line.className = className;
			line.textContent = text;
			output.append(line);
			scrollToEnd();
			return line;
		};

		const type = async (lines: string[], className = 'line') => {
			const mine = generation;
			for (const text of lines) {
				const line = addLine(`${className} typing`);
				for (let i = 0; i < text.length; i += 2) {
					if (mine !== generation || reducedMotion) break;
					line.textContent = text.slice(0, i + 2);
					scrollToEnd();
					await sleep(22);
				}
				line.textContent = text;
				line.classList.remove('typing');
				scrollToEnd();
				if (mine === generation && !reducedMotion) await sleep(70);
			}
		};

		const enqueue = (task: () => Promise<void> | void) => {
			generation++;
			queue = queue.then(task);
		};

		const run = (raw: string) => {
			const command = raw.trim();
			if (!command) return;

			enqueue(async () => {
				const echo = addLine('echo');
				echo.textContent = `$ ${command}`;

				const name = command.toLowerCase();
				if (name === 'clear') return output.replaceChildren();
				if (name === 'exit') return close();
				if (name in commands) return type(commands[name]);
				return type(['command not found, type help for a list of commands'], 'line error');
			});
		};

		const open = (from: HTMLElement) => {
			if (dialog.open) return;
			opener = from;

			const rect = from.getBoundingClientRect();
			dialog.style.setProperty('--x', `${rect.left + rect.width / 2}px`);
			dialog.style.setProperty('--y', `${rect.top + rect.height / 2}px`);

			output.replaceChildren();
			dialog.showModal();
			// Let the closed state paint first so the reveal transitions
			requestAnimationFrame(() => requestAnimationFrame(() => (dialog.dataset.state = 'open')));

			enqueue(async () => {
				if (!reducedMotion) await sleep(450);
				await type(intro);
			});
			if (finePointer) input.focus();
		};

		const close = () => {
			if (!dialog.open || dialog.dataset.state === 'closing') return;
			generation++;
			dialog.dataset.state = 'closing';
			setTimeout(
				() => {
					dialog.close();
					delete dialog.dataset.state;
					opener?.focus();
				},
				reducedMotion ? 0 : 450
			);
		};

		document.querySelectorAll<HTMLElement>('[data-terminal-open]').forEach((button) => {
			button.addEventListener('click', () => open(button));
		});

		dialog.querySelector('[data-terminal-close]')?.addEventListener('click', close);
		dialog.addEventListener('cancel', (event) => {
			event.preventDefault();
			close();
		});

		dialog.querySelectorAll<HTMLElement>('[data-command]').forEach((button) => {
			button.addEventListener('click', () => {
				run(button.dataset.command ?? '');
				if (finePointer) input.focus();
			});
		});

		form.addEventListener('submit', (event) => {
			event.preventDefault();
			run(input.value);
			input.value = '';
		});

		output.addEventListener('click', () => {
			if (finePointer && !getSelection()?.toString()) input.focus();
		});
	}
</script>

<style>
	.terminal {
		--edge: #2a2a2a;
		position: fixed;
		inset: 0;
		width: 100vw;
		max-width: none;
		height: 100dvh;
		max-height: none;
		margin: 0;
		padding: clamp(12px, 2.4vw, 40px);
		border: 0;
		background: #070707;
		color: #d8d8d8;
		font-family: var(--font-mono);
		clip-path: circle(0 at var(--x, 100%) var(--y, 0));
		transition: clip-path 0.65s cubic-bezier(0.65, 0, 0.35, 1);
	}

	.terminal[open] {
		display: flex;
		flex-direction: column;
		gap: clamp(12px, 1.4vw, 20px);
	}

	.terminal[data-state='open'] {
		clip-path: circle(150vmax at var(--x, 100%) var(--y, 0));
	}

	.terminal[data-state='closing'] {
		transition-duration: 0.45s;
	}

	.terminal::backdrop {
		background: transparent;
	}

	:global(html:has(.terminal[open])) {
		overflow: hidden;
	}

	.window {
		display: flex;
		flex: 1;
		flex-direction: column;
		min-height: 0;
		overflow: hidden;
		border: 1px solid var(--edge);
		border-radius: 14px;
		background: #111;
		opacity: 0;
		transform: translateY(14px) scale(0.985);
		transition:
			opacity 0.3s,
			transform 0.3s;
	}

	[data-state='open'] .window {
		opacity: 1;
		transform: none;
		transition:
			opacity 0.45s 0.2s,
			transform 0.6s 0.2s cubic-bezier(0.2, 0.8, 0.2, 1);
	}

	.bar {
		display: flex;
		align-items: center;
		gap: 16px;
		padding: 12px 16px;
		border-bottom: 1px solid var(--edge);
		color: #8a8a8a;
		font-size: 13px;
	}

	.dots {
		display: flex;
		gap: 7px;
	}

	.dots i {
		width: 11px;
		height: 11px;
		border-radius: 50%;
		background: #3a3a3a;
	}

	.close {
		margin-left: auto;
		padding: 0.2em 0.7em;
		border: 1px solid var(--edge);
		border-radius: 6px;
		color: inherit;
		font: inherit;
		cursor: pointer;
		transition:
			border-color 0.2s,
			color 0.2s;
	}

	@media (hover: hover) and (pointer: fine) {
		.close:hover {
			border-color: #4a4a4a;
			color: #d8d8d8;
		}
	}

	.output {
		flex: 1;
		overflow-y: auto;
		padding: clamp(16px, 2vw, 28px) clamp(16px, 2vw, 28px) 8px;
		font-size: clamp(13px, 1.15vw, 17px);
		line-height: 1.75;
	}

	.output :global(p) {
		min-height: 1.75em;
		margin: 0;
		white-space: pre-wrap;
		overflow-wrap: anywhere;
	}

	.output :global(.echo) {
		margin-top: 1em;
		color: var(--green);
	}

	.output :global(.error) {
		color: #f87171;
	}

	.output :global(.typing)::after {
		content: '';
		display: inline-block;
		width: 0.55em;
		height: 1.05em;
		margin-left: 2px;
		background: var(--green);
		vertical-align: text-bottom;
	}

	.prompt {
		display: flex;
		align-items: center;
		gap: 14px;
		padding: 12px clamp(16px, 2vw, 28px) clamp(16px, 2vw, 24px);
		font-size: clamp(13px, 1.15vw, 17px);
	}

	.ps1 {
		color: var(--green);
	}

	.prompt input {
		flex: 1;
		min-width: 0;
		border: 0;
		outline: 0;
		background: none;
		color: inherit;
		font: inherit;
		caret-color: var(--green);
	}

	.prompt input::placeholder {
		color: #5e5e5e;
	}

	.commands {
		display: flex;
		flex-wrap: wrap;
		gap: 10px;
	}

	.commands button {
		padding: 0.6em 1.3em;
		border: 1px solid var(--edge);
		border-radius: 10px;
		background: #111;
		color: #ededed;
		font: inherit;
		font-size: clamp(13px, 1.1vw, 16px);
		cursor: pointer;
		opacity: 0;
		transform: translateY(10px);
		transition:
			opacity 0.2s,
			transform 0.2s,
			border-color 0.2s,
			background-color 0.2s;
	}

	[data-state='open'] .commands button {
		opacity: 1;
		transform: none;
		transition:
			opacity 0.4s calc(0.35s + var(--i) * 60ms),
			transform 0.5s calc(0.35s + var(--i) * 60ms) cubic-bezier(0.2, 0.8, 0.2, 1),
			border-color 0.2s,
			background-color 0.2s;
	}

	.commands button:nth-child(1) {
		--i: 0;
	}
	.commands button:nth-child(2) {
		--i: 1;
	}
	.commands button:nth-child(3) {
		--i: 2;
	}
	.commands button:nth-child(4) {
		--i: 3;
	}
	.commands button:nth-child(5) {
		--i: 4;
	}

	.commands button:focus-visible {
		border-color: #4a4a4a;
		background: #1a1a1a;
	}

	@media (hover: hover) and (pointer: fine) {
		.commands button:hover {
			border-color: #4a4a4a;
			background: #1a1a1a;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.terminal,
		.window,
		.commands button {
			transition: none !important;
		}
	}
</style>
