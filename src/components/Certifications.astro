			{ name: 'Certified Specialist in Containers', detail: 'Jul 2023' },
			{ name: 'Certified Specialist in Services Management and Automation', detail: 'Aug 2023' },
		],
	},
	{
		name: 'CompTIA',
		layout: 'inline',
