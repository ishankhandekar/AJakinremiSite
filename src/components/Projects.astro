---
import { Image } from 'astro:assets';
import { projects } from '../data/projects';
import KeyEngineDemo from './KeyEngineDemo.astro';
import SectionBadge from './SectionBadge.astro';
---

<section class="projects" id="projects" data-pin-section>
	<div class="pin" data-pin>
		<header class="head">
			<SectionBadge label="Portfolio" />
			<h2 class="sr-only">Portfolio</h2>
			<p class="note">//A few things I’ve built to solve problems I kept running into</p>
			<span class="progress" aria-hidden="true"></span>
		</header>

		<div class="window" data-window>
			<div class="grid" data-track>
				{
					projects.map((project, index) => (
						<a class:list={['card', project.visual, { 'has-shot': project.crop || project.demo, 'has-demo': project.demo }]} href={`/projects/${project.slug}`}>
							<div class="text">
								<p class="index">{String(index + 1).padStart(2, '0')}</p>
								<h3>{project.title}</h3>
								<p class="description">{project.description}</p>
								<svg class="arrow" viewBox="0 0 12 12" aria-hidden="true">
									<path d="M2 10L10 2M3.5 2H10v6.5" fill="none" stroke="currentColor" stroke-width="1.1" />
								</svg>
							</div>

							{/* A recreation or a close crop of the real app where there is one, otherwise a placeholder drawing */}
							<div class="visual" aria-hidden="true">
								{project.demo === 'key-engine' ? (
									<div class="shot">
										<KeyEngineDemo />
									</div>
								) : project.crop ? (
									<Image
										class="shot"
										src={project.crop}
										alt=""
										widths={[700, 1000]}
										sizes="(max-width: 860px) 700px, 60vw"
									/>
								) : (
								<>
								{project.visual === 'app' && (
									<svg class="wire" viewBox="0 0 640 360">
										<rect class="line" x="0.5" y="0.5" width="639" height="359" rx="10" />
										<path class="line" d="M0 36h640M150 36v324" />
										<circle class="fill" cx="20" cy="18" r="4" />
										<circle class="fill" cx="34" cy="18" r="4" />
										<circle class="fill" cx="48" cy="18" r="4" />
										<rect class="fill" x="200" y="10" width="240" height="16" rx="8" />

										<rect class="accent" x="20" y="64" width="96" height="8" rx="4" />
										<rect class="fill" x="20" y="90" width="110" height="8" rx="4" />
										<rect class="fill" x="20" y="116" width="84" height="8" rx="4" />
										<rect class="fill" x="20" y="142" width="102" height="8" rx="4" />
										<rect class="fill" x="20" y="168" width="70" height="8" rx="4" />

										<rect class="fill" x="178" y="62" width="170" height="12" rx="6" />
										<rect class="line" x="178.5" y="96.5" width="134" height="64" rx="8" />
										<rect class="line" x="328.5" y="96.5" width="134" height="64" rx="8" />
										<rect class="line" x="478.5" y="96.5" width="134" height="64" rx="8" />
										<rect class="fill" x="192" y="112" width="48" height="8" rx="4" />
										<rect class="fill" x="192" y="132" width="80" height="12" rx="6" />
										<rect class="fill" x="342" y="112" width="56" height="8" rx="4" />
										<rect class="fill" x="342" y="132" width="64" height="12" rx="6" />
										<rect class="fill" x="492" y="112" width="44" height="8" rx="4" />
										<rect class="fill" x="492" y="132" width="88" height="12" rx="6" />

										<path class="line" d="M178 196h434M178 228h434M178 260h434M178 292h434M178 324h434" />
										<rect class="fill" x="178" y="207" width="190" height="8" rx="4" />
										<rect class="accent" x="560" y="206" width="52" height="10" rx="5" />
										<rect class="fill" x="178" y="239" width="150" height="8" rx="4" />
										<rect class="accent" x="560" y="238" width="52" height="10" rx="5" />
										<rect class="fill" x="178" y="271" width="210" height="8" rx="4" />
										<rect class="fill" x="560" y="270" width="52" height="10" rx="5" />
										<rect class="fill" x="178" y="303" width="170" height="8" rx="4" />
										<rect class="accent" x="560" y="302" width="52" height="10" rx="5" />
									</svg>
								)}

								{project.visual === 'terminal' && (
									<svg class="wire" viewBox="0 0 480 240">
										<rect class="line" x="0.5" y="0.5" width="479" height="239" rx="10" />
										<path class="line" d="M0 34h480" />
										<circle class="fill" cx="20" cy="17" r="4" />
										<circle class="fill" cx="34" cy="17" r="4" />
										<circle class="fill" cx="48" cy="17" r="4" />
										<rect class="fill" x="180" y="12" width="120" height="10" rx="5" />

										<path class="prompt" d="M22 58l6 5-6 5" />
										<rect class="fill" x="40" y="59" width="210" height="8" rx="4" />
										<rect class="tag" x="40" y="83" width="58" height="12" rx="6" />
										<rect class="fill" x="110" y="85" width="170" height="8" rx="4" />
										<rect class="tag" x="40" y="107" width="58" height="12" rx="6" />
										<rect class="fill" x="110" y="109" width="130" height="8" rx="4" />
										<rect class="tag" x="40" y="131" width="58" height="12" rx="6" />
										<rect class="fill" x="110" y="133" width="190" height="8" rx="4" />
										<rect class="tag" x="40" y="155" width="58" height="12" rx="6" />
										<rect class="fill" x="110" y="157" width="150" height="8" rx="4" />

										<path class="prompt" d="M22 190l6 5-6 5" />
										<rect class="accent" x="40" y="188" width="9" height="14" rx="1" />
									</svg>
								)}
								</>
								)}
							</div>
						</a>
					))
				}
			</div>
		</div>
	</div>

	<script>
		import '../scripts/pin-scroll';
	</script>
</section>

<style>
	.projects {
		--gutter: clamp(14px, 1.6vw, 24px);
		/* The page's side margin, which the cards reach across to touch the screen edge */
		--page-x: clamp(20px, 5.4vw, 90px);
		/* Placeholder drawings: hairlines and faint fills that follow the theme */
		--wire: var(--tree-line);
		--wire-fill: var(--tint);
		padding: 0 var(--page-x) clamp(64px, 9vw, 150px);
	}

	/* A pinned section above ends flush, so this one brings its own space */
	:global([data-pinned]) + .projects {
		padding-top: clamp(64px, 9vw, 150px);
	}

	.head {
		position: relative;
		margin-inline: calc(var(--gutter) * -1);
		padding: 0 var(--gutter) clamp(20px, 2.2vw, 32px);
		border-bottom: 1px solid var(--rule);
	}

	.progress {
		display: none;
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	.note {
		max-width: 62em;
		margin-top: clamp(14px, 1.5vw, 22px);
		color: var(--ink-faint);
		font-family: var(--font-mono);
		font-size: clamp(10.5px, 0.8vw, 12px);
		line-height: 1.7;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	/* One full-width row per project */
	.grid {
		display: grid;
		grid-template-columns: repeat(12, minmax(0, 1fr));
		gap: clamp(14px, 1.6vw, 24px);
		padding-top: clamp(28px, 3.4vw, 56px);
	}

	/* Pinned (set by pin-scroll.ts once it has measured the grid): the section is as
	   tall as one screen plus the grid's overflow, and its contents stick to the screen
	   while that extra height scrolls past. Same behaviour as the certifications. */
	.projects[data-pinned] {
		padding-block: 0;
	}

	[data-pinned] .pin {
		position: sticky;
		top: 0;
		display: flex;
		flex-direction: column;
		height: 100svh;
		padding-block: clamp(76px, 7.5vw, 116px) clamp(20px, 2.4vw, 40px);
	}

	[data-pinned] .window {
		flex: 1;
		min-height: 0;
		overflow: hidden;
		/* Spans the full screen width so the cards can run into its edges */
		margin-inline: calc(var(--page-x) * -1);
		padding-inline: var(--page-x);
		mask-image: linear-gradient(to bottom, transparent, #000 28px, #000 calc(100% - 48px), transparent);
	}

	[data-pinned] .grid {
		padding-block: clamp(30px, 3.4vw, 56px) 56px;
		will-change: transform;
	}

	/* The header's divider fills with green as the cards scroll through */
	[data-pinned] .progress {
		position: absolute;
		inset: auto 0 -1px;
		display: block;
		height: 1px;
		background: var(--green);
		transform: scaleX(var(--progress, 0));
		transform-origin: left;
	}

	/* Cards alternate which edge of the screen they run into: the first the right, the
	   next the left. That side loses its border and corners, and its padding grows by the
	   page margin so the content still lines up with the rest of the page. */
	.card {
		--pad: clamp(20px, 2.2vw, 34px);
		--pad-left: var(--pad);
		--pad-right: calc(var(--pad) + var(--page-x));
		display: flex;
		flex-direction: column;
		gap: clamp(22px, 2.4vw, 36px);
		grid-column: 1 / -1;
		margin-right: calc(-1 * var(--page-x));
		padding: var(--pad) var(--pad-right) var(--pad) var(--pad-left);
		border: 1px solid var(--rule);
		border-right: 0;
		border-radius: 16px 0 0 16px;
		transition:
			background-color 0.35s,
			border-color 0.35s,
			transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
	}

	.card:nth-child(even) {
		--pad-left: calc(var(--pad) + var(--page-x));
		--pad-right: var(--pad);
		margin-right: 0;
		margin-left: calc(-1 * var(--page-x));
		border-right: 1px solid var(--rule);
		border-left: 0;
		border-radius: 0 16px 16px 0;
	}

	.card:focus-visible {
		outline: 2px solid var(--green);
		outline-offset: 3px;
	}

	.text {
		position: relative;
		padding-right: clamp(28px, 3vw, 44px);
	}

	.index {
		color: var(--ink-faint);
		font-family: var(--font-mono);
		font-size: clamp(11px, 0.85vw, 13px);
		letter-spacing: 0.1em;
	}

	h3 {
		margin: 0.7em 0 0;
		font-family: var(--font-display);
		font-size: clamp(21px, 1.9vw, 30px);
		font-weight: 500;
		line-height: 1.15;
		letter-spacing: -0.02em;
		text-wrap: balance;
	}

	.app h3 {
		font-size: clamp(24px, 2.5vw, 40px);
	}

	.description {
		max-width: 44em;
		margin-top: 0.9em;
		color: var(--ink-body);
		font-size: clamp(14px, 1.05vw, 16px);
		line-height: 1.65;
	}

	.arrow {
		position: absolute;
		top: 0;
		right: 0;
		width: clamp(14px, 1.3vw, 18px);
		height: auto;
		color: var(--ink-faint);
		transition:
			color 0.3s,
			transform 0.45s cubic-bezier(0.22, 1, 0.36, 1);
	}

	/* The drawing fills whatever height the row leaves under the text */
	.visual {
		display: flex;
		flex: 1;
		align-items: flex-end;
		gap: clamp(16px, 2vw, 32px);
	}

	.wire {
		display: block;
		width: 100%;
		height: auto;
	}

	.wire .line,
	.wire .prompt {
		fill: none;
		stroke: var(--wire);
		stroke-width: 1;
		vector-effect: non-scaling-stroke;
	}

	.wire .prompt {
		stroke: var(--green);
		stroke-width: 1.5;
	}

	.wire .fill {
		fill: var(--wire-fill);
	}

	.wire .tag {
		fill: none;
		stroke: var(--wire);
		vector-effect: non-scaling-stroke;
	}

	.wire .accent {
		fill: var(--green);
		opacity: 0.55;
	}

	/* A real screenshot runs off the card's bottom and right edges, where the card's rounded
	   corner cuts it off; on hover it slides up out of the corner */
	.has-shot {
		overflow: hidden;
	}

	.has-shot .visual {
		position: relative;
		min-height: clamp(230px, 24vw, 400px);
		margin: 0 calc(-1 * var(--pad-right)) calc(-1 * var(--pad)) 0;
	}

	.shot {
		position: absolute;
		top: 0;
		left: 0;
		/* Kept large so the interface stays legible, even on a phone */
		width: max(118%, 660px);
		height: auto;
		max-width: none;
		/* The crop starts at the panel's own border; this rounds off its corner cleanly */
		border-radius: 14px 0 0 0;
		transition:
			transform 0.6s cubic-bezier(0.22, 1, 0.36, 1),
			box-shadow 0.6s;
	}

	/* The recreated panel sets its own type sizes, so it needs less overhang than a screenshot.
	   Tall enough to show everything down to the result, with the key running off the bottom */
	.has-demo .visual {
		min-height: 480px;
	}

	/* Always runs past the card's bottom edge, however tall the row is */
	.has-demo .shot {
		bottom: -2px;
		width: max(110%, 360px);
	}

	/* Phones: the panel spans the card edge to edge, set off from the text by a single
	   hairline, and the card's own rounded corners trim it at the bottom */
	@media (max-width: 860px) {
		.has-demo .visual {
			margin-left: calc(-1 * var(--pad-left));
		}

		.has-demo .shot {
			width: 100%;
		}

		.has-demo .shot :global(.engine) {
			padding-inline: var(--pad-left) var(--pad-right);
			border-width: 1px 0 0;
			border-radius: 0;
		}
	}

	/* The app wireframe keeps a true 16:9 frame */
	.app .wire {
		aspect-ratio: 16 / 9;
	}

	@media (hover: hover) and (pointer: fine) {
		.card:hover {
			border-color: var(--tree-line);
			background: var(--tint-faint);
			transform: translateY(-4px) scale(1.004);
		}

		.card:hover .arrow {
			color: var(--green);
			transform: translate(3px, -3px);
		}

		.card:hover .shot {
			transform: translate(-8px, -10px);
			box-shadow: 0 24px 48px -24px rgb(0 0 0 / 0.45);
		}
	}

	/* Wider screens: text on one side, the visual on the other, swapping sides each row */
	@media (min-width: 861px) {
		.card {
			display: grid;
			grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
			align-items: center;
			gap: clamp(32px, 4.5vw, 80px);
			min-height: clamp(380px, 34vw, 540px);
		}

		.card:nth-child(even) {
			grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
		}

		.has-demo {
			min-height: clamp(480px, 39vw, 580px);
		}

		/* Here the row's height decides, so the key runs off the bottom edge */
		.has-demo .visual {
			min-height: 0;
		}

		.card:nth-child(even) .text {
			order: 2;
		}

		.visual {
			align-items: center;
		}

		/* A bled panel fills the full height of its row, running off the right and bottom edges */
		.has-shot .visual {
			align-self: stretch;
			margin-top: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.card,
		.arrow,
		.shot {
			transition: none;
		}
	}
</style>
