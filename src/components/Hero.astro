---
const stats = [
	{ value: '230', suffix: '+', label: 'Linux servers administered' },
	{ value: '85', suffix: '%', label: 'Faster workstation deployment' },
	{ value: '20', label: 'Industry certifications' },
];
---

<section class="hero">
	<div class="rail" aria-hidden="true">
		<span>Linux &amp; DevOps</span>
		<i></i>
		<span>San Diego, CA</span>
	</div>

	<div class="content">
		<dl class="stats">
			{
				stats.map((stat) => (
					<div class="stat">
						<dt>{stat.label}</dt>
						<dd>
							{stat.value}
							{stat.suffix && <sup>{stat.suffix}</sup>}
						</dd>
					</div>
				))
			}
		</dl>

		<div class="intro">
			<h1>
				<span class="sr-only">I’m AJ</span>
				<span aria-hidden="true" data-typed>I’m AJ</span><span class="caret" aria-hidden="true"></span>
			</h1>
			<!-- Inline so the headline is cleared before first paint -->
			<script is:inline>
				(() => {
					const el = document.querySelector('[data-typed]');
					const caret = el?.nextElementSibling;
					if (!el || !caret || matchMedia('(prefers-reduced-motion: reduce)').matches) return;

					const headline = el.textContent;
					el.textContent = '';

					const sleep = (ms) => new Promise((resolve) => setTimeout(resolve, ms));
					// The caret holds steady while keys are going and blinks when idle
					const busy = async (work) => {
						caret.classList.add('busy');
						await work();
						caret.classList.remove('busy');
					};
					const type = (text, speed) =>
						busy(async () => {
							for (const char of text) {
								el.textContent += char;
								await sleep(speed + Math.random() * 50);
							}
						});
					const erase = (speed) =>
						busy(async () => {
							while (el.textContent) {
								el.textContent = el.textContent.slice(0, -1);
								await sleep(speed);
							}
						});

					const run = async () => {
						await sleep(700);
						await type('Hi', 150);
						await sleep(900);
						await erase(120);
						await sleep(1000);
						await type(headline, 120);
					};

					Promise.race([document.fonts.load('400 1em Altform'), sleep(800)]).then(run, run);
				})();
			</script>
			<p class="meta">
				Senior Technical Support Engineer
			</p>
		</div>

		<a class="scroll" href="#about">
			Scroll down
			<svg viewBox="0 0 10 12" width="9" height="11" aria-hidden="true">
				<path d="M5 0v10.5M1 6.5l4 4 4-4" fill="none" stroke="currentColor" stroke-width="1.1"></path>
			</svg>
		</a>
	</div>

	<!-- Placeholder silhouette: swap for the headshot -->
	<div class="portrait" aria-hidden="true">
		<svg viewBox="0 0 660 580" preserveAspectRatio="xMidYMax meet">
			<defs>
				<linearGradient id="silhouette" x1="0" y1="0" x2="0" y2="1">
					<stop offset="0" style="stop-color: var(--silhouette-top)"></stop>
					<stop offset="1" style="stop-color: var(--silhouette-bottom)"></stop>
				</linearGradient>
			</defs>
			<path
				fill="url(#silhouette)"
				d="M330 60c-85 0-140 62-140 150 0 60 22 112 58 146v44c0 18-12 30-34 38l-110 40c-52 20-84 56-84 102h620c0-46-32-82-84-102l-110-40c-22-8-34-20-34-38v-44c36-34 58-86 58-146 0-88-55-150-140-150z"
			></path>
		</svg>
	</div>
</section>

<style>
	.hero {
		position: relative;
		display: flex;
		height: 100svh;
		min-height: 560px;
		overflow: hidden;
	}

	.rail {
		position: absolute;
		top: 17.5%;
		bottom: 8%;
		left: 5.6vw;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: clamp(14px, 1.7vw, 26px);
		color: var(--ink-muted);
		font-size: clamp(12px, 1.15vw, 17px);
	}

	.rail span {
		writing-mode: vertical-rl;
		transform: rotate(180deg);
		white-space: nowrap;
	}

	.rail i {
		flex: 1;
		width: 1px;
		background: currentColor;
		opacity: 0.7;
	}

	.content {
		position: relative;
		z-index: 2;
		display: flex;
		flex-direction: column;
		width: 100%;
		padding: 21.5svh 0 7.2svh 13.8vw;
	}

	.stats {
		display: flex;
		gap: clamp(20px, 2.2vw, 40px);
	}

	.stat {
		display: flex;
		flex-direction: column-reverse;
		justify-content: flex-end;
		gap: 0.35em;
	}

	.stat dd {
		display: flex;
		align-items: flex-start;
		font-size: clamp(30px, 3.3vw, 54px);
		font-weight: 300;
		line-height: 1;
		letter-spacing: -0.02em;
	}

	.stat sup {
		position: static;
		margin-left: 0.08em;
		color: var(--green);
		font-size: 0.55em;
		line-height: 1.1;
	}

	.stat dt {
		max-width: 14em;
		font-size: clamp(10px, 0.8vw, 12px);
		line-height: 1.35;
		text-transform: uppercase;
	}

	.intro {
		margin-top: auto;
		margin-bottom: auto;
		padding-bottom: 7svh;
	}

	h1 {
		margin-left: -0.03em;
		font-family: var(--font-display);
		font-size: clamp(110px, 14.5vw, 280px);
		font-weight: 400;
		line-height: 0.84;
		letter-spacing: -0.045em;
		min-height: 0.84em;
		white-space: nowrap;
	}

	.caret {
		display: inline-block;
		width: 0.05em;
		height: 0.74em;
		margin-left: 0.07em;
		background: var(--green);
		animation: caret-blink 1.05s steps(1) infinite;
	}

	.caret.busy {
		animation: none;
	}

	@keyframes caret-blink {
		50% {
			opacity: 0;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.caret {
			animation: none;
		}
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	.meta {
		display: inline-grid;
		gap: 0.5em;
		margin-top: clamp(18px, 2.4vw, 40px);
		padding-top: 1.3em;
		background: linear-gradient(to right, var(--green) 2.6em, var(--ink-muted) 2.6em) top / 100% 1px
			no-repeat;
		color: var(--ink-soft);
		font-family: var(--font-mono);
		font-size: clamp(11px, 0.85vw, 13px);
		font-weight: 400;
		line-height: 1.4;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.scroll {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		align-self: flex-start;
		font-size: clamp(13px, 1.2vw, 18px);
	}

	.scroll svg {
		color: var(--green);
		transition: transform 0.2s;
	}

	@media (hover: hover) and (pointer: fine) {
		.scroll:hover svg {
			transform: translateY(3px);
		}
	}

	.portrait {
		position: absolute;
		right: -3vw;
		bottom: 0;
		z-index: 1;
		height: 97%;
		aspect-ratio: 660 / 580;
	}

	.portrait svg {
		display: block;
		width: 100%;
		height: 100%;
	}

	@media (max-width: 720px) {
		.rail {
			display: none;
		}

		.content {
			padding: 13svh 20px 28px;
		}

		.stats {
			display: grid;
			grid-template-columns: repeat(2, max-content);
			gap: 16px 36px;
		}

		.intro {
			margin-top: 6svh;
			padding-bottom: 0;
		}

		h1 {
			font-size: 31vw;
		}

		.portrait {
			right: 0;
			height: 38%;
		}
	}
</style>
