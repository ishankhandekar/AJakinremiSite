---
import SectionBadge from './SectionBadge.astro';

const nodes = [
	{
		key: 'education@latest',
		value: 'BSc in Computer Science (In Progress)',
		detail: 'San Diego Mesa College',
	},
	{
		key: 'environment//core',
		value: 'Enterprise Linux',
		detail: 'RedHat Enterprise Linux (RHEL), CentOS, Oracle Linux',
	},
	{
		key: 'tooling//custom',
		value: 'SSL2ool Automation Suite',
	},
];
---

<section class="about" id="about">
	<header class="head">
		<SectionBadge label="Biography" />
		<h2 class="sr-only">About AJ</h2>
	</header>

	<div class="body">
		<div class="bio">
			<p class="lead">
				I started out putting out fires. Now I build the systems that keep them from starting.
			</p>
			<p>
				I began on the help desk, where the job was resolving whatever broke that day. At Stryker
				the work runs the other way: engineering automation that scales, so a problem is solved
				once instead of every time it comes back. Day to day that means managing Linux
				infrastructure, building custom tools where none exist, and keeping the systems underneath
				secure.
			</p>
			<p>
				The principle behind all of it is simple. If a task is repetitive and easy to get wrong, it
				should be automated away, not done by hand.
			</p>
		</div>

		<dl class="tree">
			{
				nodes.map((node) => (
					<div class="node">
						<dt>{node.key}</dt>
						<dd class="value">{node.value}</dd>
						{node.detail && <dd class="detail">{node.detail}</dd>}
					</div>
				))
			}
		</dl>
	</div>
</section>

<style>
	.about {
		--gutter: clamp(14px, 1.6vw, 24px);
		padding: clamp(64px, 9vw, 150px) clamp(20px, 5.4vw, 90px) 0;
	}

	.head {
		margin-inline: calc(var(--gutter) * -1);
		padding: 0 var(--gutter) clamp(20px, 2.2vw, 32px);
		border-bottom: 1px solid var(--rule);
	}

	.sr-only {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	.body {
		display: grid;
		grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
		align-items: start;
		gap: clamp(40px, 7vw, 130px);
		padding-top: clamp(32px, 4vw, 64px);
	}

	.lead {
		color: var(--ink);
		font-family: var(--font-display);
		font-size: clamp(24px, 2.5vw, 42px);
		line-height: 1.2;
		letter-spacing: -0.02em;
		text-wrap: balance;
	}

	.bio p + p {
		max-width: 38em;
		margin-top: 1.3em;
		color: var(--ink-body);
		font-size: clamp(15px, 1.2vw, 18px);
		line-height: 1.75;
	}

	.bio .lead + p {
		margin-top: clamp(22px, 2.4vw, 40px);
	}

	/* A dependency tree drawn with hairlines: a trunk down the left edge and a
	   short branch into each node. The last node's trunk stops at its branch. */
	.tree {
		--branch: clamp(18px, 1.7vw, 26px);
		--key-size: clamp(11.5px, 0.85vw, 13px);
		margin: 0;
		padding-top: 0.4em;
	}

	.node {
		position: relative;
		padding: 0 0 clamp(28px, 3vw, 46px) calc(var(--branch) + 0.9em);
	}

	.node:last-child {
		padding-bottom: 0;
	}

	.node::before,
	.node::after {
		content: '';
		position: absolute;
		left: 0;
		background: var(--tree-line);
	}

	.node::before {
		top: 0;
		bottom: 0;
		width: 1px;
	}

	.node::after {
		top: calc(var(--key-size) * 0.75);
		width: var(--branch);
		height: 1px;
	}

	.node:last-child::before {
		bottom: auto;
		height: calc(var(--key-size) * 0.75 + 1px);
	}

	dt {
		color: var(--ink-faint);
		font-family: var(--font-mono);
		font-size: var(--key-size);
		line-height: 1.5;
		letter-spacing: 0.06em;
	}

	.value {
		margin-top: 0.7em;
		color: var(--ink);
		font-size: clamp(17px, 1.5vw, 23px);
		line-height: 1.3;
		letter-spacing: -0.01em;
	}

	.detail {
		margin-top: 0.45em;
		color: var(--ink-body);
		font-size: clamp(14px, 1.05vw, 16px);
		line-height: 1.55;
	}

	@media (max-width: 860px) {
		.body {
			grid-template-columns: minmax(0, 1fr);
			gap: 40px;
		}
	}
</style>
