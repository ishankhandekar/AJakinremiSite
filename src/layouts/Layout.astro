---
import '@fontsource-variable/geist';
import '@fontsource/ibm-plex-mono/400.css';
import '../styles/global.css';

interface Props {
	title?: string;
}

const { title = 'AJ Akinremi' } = Astro.props;
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://api.fontshare.com" />
		<link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://api.fontshare.com/v2/css?f[]=general-sans@300,400,500,700&display=swap"
		/>
		<title>{title}</title>
		<script is:inline>
			// Before first paint: use the visitor's saved choice, otherwise follow their device
			(() => {
				let saved = null;
				try {
					saved = localStorage.getItem('theme');
				} catch {}
				const dark = saved ? saved === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches;
				document.documentElement.classList.toggle('dark', dark);
			})();
		</script>
	</head>
	<body>
		<slot />
	</body>
</html>

<script>
	import Lenis from 'lenis';
	import 'lenis/dist/lenis.css';

	declare global {
		interface Window {
			lenis?: Lenis;
		}
	}

	// Wheel-scroll inertia; touch devices keep their native momentum
	if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
		const lenis = new Lenis({ autoRaf: true, anchors: true, lerp: 0.09 });
		// The hero intro locks the page at the top until it's done (see Hero.astro), and starts it again itself
		window.lenis = lenis;
		if ('introLock' in document.documentElement.dataset) lenis.stop();
	}
</script>

<style is:global>
	:root {
		--bg: #f2f2f2;
		--ink: #262626;
		--ink-soft: #4a4a4a;
		--ink-faint: #767676;
		--ink-muted: #b4b4b4;
		--line: #e0e0e0;
		--line-strong: #d4d4d4;
		--chip: #e6e6e6;
		--ink-body: #636363;
		--ink-dim: #a3a3a3;
		--rule: rgb(0 0 0 / 0.1);
		--tree-line: rgb(0 0 0 / 0.16);
		--tint: rgb(0 0 0 / 0.05);
		--tint-faint: rgb(0 0 0 / 0.03);
		--scrim: rgb(255 255 255 / 0.7);
		--surface: #fff;
		--green: #12a150;
		--on-green: #08130c;
		--silhouette-top: #c9c9c9;
		--silhouette-bottom: #d9d9d9;
		--font-sans: 'General Sans', 'Helvetica Neue', Helvetica, Arial, sans-serif;
		--font-display: 'Geist Variable', var(--font-sans);
		--font-mono: 'IBM Plex Mono', ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
	}

	:root.dark {
		--bg: #000;
		--ink: #ededed;
		--ink-soft: #c4c4c4;
		--ink-faint: #8f8f8f;
		--ink-muted: #5c5c5c;
		--line: #262626;
		--line-strong: #363636;
		--chip: #1c1c1c;
		--ink-body: #999;
		--ink-dim: #555;
		--rule: rgb(255 255 255 / 0.07);
		--tree-line: rgb(255 255 255 / 0.14);
		--tint: rgb(255 255 255 / 0.05);
		--tint-faint: rgb(255 255 255 / 0.025);
		--scrim: rgb(0 0 0 / 0.55);
		--surface: #0b0b0b;
		--green: #3ee07f;
		--silhouette-top: #2c2c2c;
		--silhouette-bottom: #1d1d1d;
		color-scheme: dark;
	}

	/* The theme button drives this transition itself (see Header.astro) */
	::view-transition-old(root),
	::view-transition-new(root) {
		animation: none;
		mix-blend-mode: normal;
	}

	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}

	html {
		-webkit-text-size-adjust: 100%;
	}

	body {
		margin: 0;
		background: var(--bg);
		color: var(--ink);
		font-family: var(--font-sans);
		font-weight: 400;
		line-height: normal;
		-webkit-font-smoothing: antialiased;
		-moz-osx-font-smoothing: grayscale;
	}

	::selection {
		background: var(--green);
		color: var(--on-green);
	}

	a {
		color: inherit;
		text-decoration: none;
	}

	h1,
	p,
	dl,
	dd {
		margin: 0;
	}
</style>
